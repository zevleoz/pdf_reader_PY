{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://future-ark.example/schemas/yuguo-first-touch/student-handoff-request.schema.json",
  "title": "First Touch student handoff request",
  "type": "object",
  "additionalProperties": false,
  "required": ["studentIds"],
  "properties": {
    "studentIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  }
}
