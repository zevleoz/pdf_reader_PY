{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://future-ark.example/schemas/junction.identity_link.1.0.0.schema.json",
  "title": "Verified external identity link 1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "linkId", "junctionStudentId", "revision", "status", "issuedAt", "idempotencyKey", "source", "external", "review", "authorization"],
  "properties": {
    "schema": {"const": "junction.identity_link.1.0.0"},
    "linkId": {"$ref": "#/$defs/id"}, "junctionStudentId": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1}, "status": {"enum": ["active", "revoked"]},
    "issuedAt": {"type": "string", "format": "date-time"}, "idempotencyKey": {"$ref": "#/$defs/id"},
    "source": {"type": "object", "additionalProperties": false, "required": ["system", "recordId"], "properties": {
      "system": {"const": "sales_crm"}, "recordId": {"$ref": "#/$defs/id"}
    }},
    "external": {"type": "object", "additionalProperties": false, "required": ["system", "studentId"], "properties": {
      "system": {"$ref": "#/$defs/systemId"},
      "studentId": {"$ref": "#/$defs/id"}
    }},
    "review": {"type": "object", "additionalProperties": false, "required": ["reviewedBy", "reviewedAt", "method", "evidenceRef"], "properties": {
      "reviewedBy": {"$ref": "#/$defs/id"}, "reviewedAt": {"type": "string", "format": "date-time"},
      "method": {"const": "manual_identity_verification"}, "evidenceRef": {"$ref": "#/$defs/id"}
    }},
    "authorization": {"type": "object", "additionalProperties": false, "required": ["grantId", "recipient", "purpose", "grantedAt"], "properties": {
      "grantId": {"$ref": "#/$defs/id"}, "recipient": {"$ref": "#/$defs/systemId"},
      "purpose": {"$ref": "#/$defs/purposeId"}, "grantedAt": {"type": "string", "format": "date-time"},
      "expiresAt": {"type": ["string", "null"], "format": "date-time"},
      "capabilities": {"$ref": "#/$defs/capabilities"}
    }}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160},
    "systemId": {"type": "string", "pattern": "^[a-z][a-z0-9_:-]{0,159}$"},
    "purposeId": {"type": "string", "pattern": "^[a-z][a-z0-9_:-]{0,159}$"},
    "capabilities": {"type": "object", "additionalProperties": false, "properties": {
      "scope": {"type": "array", "uniqueItems": true, "maxItems": 50, "items": {"$ref": "#/$defs/id"}},
      "actions": {"type": "array", "uniqueItems": true, "maxItems": 50, "items": {"$ref": "#/$defs/id"}}
    }}
  }
}
