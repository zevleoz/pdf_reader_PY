{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://future-ark.example/schemas/junction.crm_student_handoff.1.0.0.schema.json",
  "title": "CRM student handoff 1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "junctionStudentId", "revision", "issuedAt", "idempotencyKey", "source", "authorization", "student", "assignments", "identityLinkIds"],
  "properties": {
    "schema": {"const": "junction.crm_student_handoff.1.0.0"},
    "junctionStudentId": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "issuedAt": {"type": "string", "format": "date-time"},
    "idempotencyKey": {"$ref": "#/$defs/id"},
    "source": {"$ref": "#/$defs/source"},
    "authorization": {"$ref": "#/$defs/authorization"},
    "student": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "grade": {"type": ["string", "null"], "maxLength": 100},
        "school": {"type": ["string", "null"], "maxLength": 300},
        "contactPhone": {"type": ["string", "null"], "maxLength": 40}
      }
    },
    "assignments": {"type": "array", "uniqueItems": true, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["service", "assignmentId", "assignmentVersion", "status", "effectiveAt"],
      "properties": {
        "service": {"$ref": "#/$defs/serviceId"},
        "assignmentId": {"$ref": "#/$defs/id"},
        "assignmentVersion": {"type": "integer", "minimum": 1},
        "status": {"enum": ["active", "revoked"]},
        "effectiveAt": {"type": "string", "format": "date-time"},
        "assigneeRef": {"type": ["string", "null"], "maxLength": 160}
      }
    }},
    "identityLinkIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160},
    "source": {"type": "object", "additionalProperties": false, "required": ["system", "recordId"], "properties": {
      "system": {"const": "sales_crm"}, "recordId": {"$ref": "#/$defs/id"}
    }},
    "authorization": {"type": "object", "additionalProperties": false, "required": ["grantId", "recipient", "purpose", "grantedAt"], "properties": {
      "grantId": {"$ref": "#/$defs/id"}, "recipient": {"$ref": "#/$defs/serviceId"},
      "purpose": {"$ref": "#/$defs/purposeId"}, "grantedAt": {"type": "string", "format": "date-time"},
      "expiresAt": {"type": ["string", "null"], "format": "date-time"},
      "capabilities": {"$ref": "#/$defs/capabilities"}
    }},
    "serviceId": {"type": "string", "pattern": "^[a-z][a-z0-9_:-]{0,159}$"},
    "purposeId": {"type": "string", "pattern": "^[a-z][a-z0-9_:-]{0,159}$"},
    "capabilities": {"type": "object", "additionalProperties": false, "properties": {
      "scope": {"type": "array", "uniqueItems": true, "maxItems": 50, "items": {"$ref": "#/$defs/id"}},
      "actions": {"type": "array", "uniqueItems": true, "maxItems": 50, "items": {"$ref": "#/$defs/id"}}
    }}
  }
}
