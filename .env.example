# 视觉 API 配置文件 — 复制为 .env 后填入你的 Key
# 方法: cp .env.example .env ; 然后编辑填入 key

# ===== 阿里云 DashScope (推荐⭐ - 中文最好) =====
# 获取: https://dashscope.console.aliyun.com/
# 模型: qwen2.5-vl-72b-instruct
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ===== 硅基流动 SiliconFlow (便宜，有免费额度) =====
# 获取: https://cloud.siliconflow.cn/
# 模型: Qwen/Qwen2.5-VL-72B-Instruct
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# ===== 智谱 GLM (glm-4v-flash 很便宜) =====
# 获取: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here

# ===== OpenAI (需代理，推荐 gpt-4o-mini) =====
OPENAI_API_KEY=your_openai_api_key_here
