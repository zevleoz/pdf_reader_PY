# 视觉 API 配置文件 — 复制为 .env 后填入你的 Key
# 方法: cp .env.example .env ; 然后编辑填入 key

# ===== 阿里云 DashScope (推荐⭐ - 中文最好) =====
# 获取: https://dashscope.console.aliyun.com/
# 模型: qwen2.5-vl-72b-instruct
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ===== 硅基流动 SiliconFlow (便宜，有免费额度) =====
# 获取: https://cloud.siliconflow.cn/
# 模型: Qwen/Qwen2.5-VL-72B-Instruct
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# ===== 智谱 GLM (glm-4v-flash 很便宜) =====
# 获取: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here

# ===== OpenAI (需代理，推荐 gpt-4o-mini) =====
OPENAI_API_KEY=your_openai_api_key_here

# ===== 外部 API（供其他网站下载 Y4 报告） =====
# 必填：外部网站调用 /api/v1/* 时携带的 Bearer Token
Y4_API_KEY=change-me-to-a-long-random-string
# 可选：CORS 允许来源，逗号分隔；默认 *（任意来源）
Y4_API_CORS_ORIGINS=*
# 可选：每 IP 每分钟请求上限；默认 60
Y4_API_RATE_LIMIT=60
# 可选：E4 协议端点（实时调 AI）每 IP 每分钟上限；默认 8
Y4_API_E4_RATE_LIMIT=8
